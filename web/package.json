{
  "name": "tripmate-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TripMate 前端（Vue 3 + TypeScript + Vite），构建产物由 scripts/sync-static.mjs 同步进 TripMate/static/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-static.mjs",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright-core": "^1.49.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
