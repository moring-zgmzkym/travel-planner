<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
@page { size: A4; margin: 0 12mm 16mm 12mm; }
html, body { margin: 0; padding: 0; }
{{ css|safe }}
</style>
</head>
<body>

{# ── 壹 出发前90秒速览 ─────────────────────────── #}
{% if snapshot %}
<section class="sec" style="margin-top:0">
  <div class="sec-head"><div class="sec-num">{{ chapters[0] }}</div><h2>{{ sec_titles[0] }}</h2><span class="sec-en">Overview · Read Me First</span></div>
  <div class="sec-sub">{{ basic.origin }} → {{ basic.destination }} · {{ basic.dates_txt }} · {{ basic.party }} 人同行</div>
  <div class="sec-rule"></div>
  <div class="stat-chips">
    {% for num, lab in snapshot.chips %}
    <div class="st"><div class="num">{{ num }}</div><div class="lab">{{ lab }}</div></div>
    {% endfor %}
  </div>
  {% if snapshot.intro %}
  <div class="tipbox"><span class="lead">为什么这么排：</span>{{ snapshot.intro }}</div>
  {% endif %}
  <div class="subhead"><h3>每日主线 · 一条线讲完</h3></div>
  <table class="tbl">
    <tr><th style="width:13%">天次 / 日期</th><th style="width:16%">当日主题</th><th>一条线讲完</th><th style="width:20%">节奏要点</th></tr>
    {% for r in snapshot.day_rows %}
    <tr>
      <td><b>{{ r.label }}</b>{% if r.weekday %}　{{ r.date }} {{ r.weekday }}{% endif %}</td>
      <td><b>{{ r.theme }}</b></td>
      <td>{{ r.line }}</td>
      <td class="muted">{{ r.meta }}</td>
    </tr>
    {% endfor %}
  </table>

  <div class="subhead"><h3>行程档案</h3></div>
  <table class="tbl kv">
    {% for k1, v1, k2, v2 in overview_rows %}
    <tr>
      <td class="lab k">{{ k1 }}</td><td class="v">{{ v1 }}</td>
      <td class="lab k2">{{ k2 }}</td><td>{{ v2 }}</td>
    </tr>
    {% endfor %}
  </table>

  <div class="subhead"><h3>设计原则 —— 本路书的安排底线</h3><span class="tag">通用建议</span></div>
  <div class="grid4">
    {% for zi, t, d in principles %}
    <div class="card principle"><span class="zi">{{ zi }}</span><div class="t">{{ t }}</div><div class="d">{{ d }}</div></div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── 贰 推荐订单清单 ───────────────────────────── #}
{% if orders.rows %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[1] }}</div><h2>{{ sec_titles[1] }}</h2><span class="sec-en">Ticket List</span></div>
  <div class="sec-sub">Agent 已按您的要求筛选勾选 · 支付请在官方渠道完成</div>
  <div class="sec-rule"></div>
  <table class="tbl">
    <tr><th>类型</th><th>名称 / 班次</th><th>关键信息</th><th>推荐理由</th><th>直达链接</th></tr>
    {% for o in orders.rows %}
    <tr class="{{ 'sel' if o.selected }}">
      <td class="kind">{{ o.kind }}</td>
      <td><b>{{ o.name }}</b>{% if o.selected %}<span class="badge-sel">√ 已勾选</span>{% endif %}</td>
      <td class="wrap-bal">{{ o.info }}</td>
      <td class="wrap-bal">{{ o.reason }}</td>
      <td>{% if o.link %}<a href="{{ o.link }}">{{ o.link_label }} →</a>{% else %}<span class="muted">—</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="mt4"><b>{{ orders.total }}</b></p>
  {% if orders.ref_note %}<p class="note" style="color:var(--red)">{{ orders.ref_note }}</p>{% endif %}
</section>
{% endif %}

{# ── 叁 抢约闹钟日历 ───────────────────────────── #}
{% if alarms %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[2] }}</div><h2>{{ sec_titles[2] }}</h2><span class="sec-en">Set Alarms Now</span></div>
  <div class="sec-sub">把下面每个时间点设成手机闹钟 · 到点即抢，错过再等一年</div>
  <div class="sec-rule"></div>
  <table class="tbl">
    <tr><th style="width:17%">时间</th><th style="width:34%">动作</th><th>渠道 / 要点</th><th style="width:11%">难度</th></tr>
    {% for a in alarms.rows %}
    <tr>
      <td><b>{{ a.when }}</b></td>
      <td>{{ a.action }}</td>
      <td class="muted">{{ a.channel }}</td>
      <td><span class="diff">{{ a.difficulty }}</span></td>
    </tr>
    {% endfor %}
  </table>
</section>
{% endif %}

{# ── 肆 行程节奏与甘特 ─────────────────────────── #}
{% if gantt %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[3] }}</div><h2>{{ sec_titles[3] }}</h2><span class="sec-en">Daily Rhythm</span></div>
  <div class="sec-sub">色块即行程 · 张弛配比一图看懂</div>
  <div class="sec-rule"></div>
  <div class="gantt">
    {% for r in gantt.rows %}
    <div class="g-row">
      <div class="g-label"><span>{{ r.label }}</span><span class="muted" style="font-size:7.6pt">{{ r.date }}</span></div>
      {% for color, phase, text in r.blocks %}
      <div class="g-block" style="background:{{ color }}"><b>{{ phase }}</b>{{ text }}</div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  <div class="gantt-legend">
    <span><span class="sw" style="background:{{ gantt.colors[0] }}"></span>上午</span>
    <span><span class="sw" style="background:{{ gantt.colors[1] }}"></span>下午</span>
    <span><span class="sw" style="background:{{ gantt.colors[2] }}"></span>晚上</span>
  </div>
  {% if gantt.note %}<p class="note">节奏说明：{{ gantt.note }}</p>{% endif %}
</section>
{% endif %}

{# ── 伍 天气与穿搭（无预报整体隐藏）────────────── #}
{% if weather and weather.rows %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[4] }}</div><h2>{{ sec_titles[4] }}</h2><span class="sec-en">Weather & Outfit</span></div>
  <div class="sec-sub">确定性穿搭规则 · 出发前请再次确认最新预报</div>
  <div class="sec-rule"></div>
  <div class="wx">
    {% for w in weather.rows %}
    <div class="card">
      <div class="ic">{{ w.emoji }}</div>
      <div class="dt">{{ w.date }}</div>
      <div class="tx">{{ w.day_text }}</div>
      <div class="tp">{{ w.temp }}</div>
    </div>
    {% endfor %}
  </div>
  {% for w in weather.rows %}<p class="mt4"><b>{{ w.date }}</b>（{{ w.day_text }}）：{{ w.advice }}</p>{% endfor %}
  {% if weather.curve %}<div class="card mt8">{{ weather.curve|safe }}</div>{% endif %}
  {% if weather.source %}<p class="note">数据源：{{ weather.source }}（预报窗约 16 天，出发前请再次确认）</p>{% endif %}
</section>
{% endif %}

{# ── 陆 逐日行程 ──────────────────────────────── #}
{% if days %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[5] }}</div><h2>{{ sec_titles[5] }}</h2><span class="sec-en">Day by Day</span></div>
  <div class="sec-sub">按天拆解主题动线、时段安排与导航路线</div>
  <div class="sec-rule"></div>

  {% for d in days %}
  <div class="day-wrap">
    <div class="day-banner">
      <div class="dbadge"><b>D{{ d.n }}</b><i>DAY {{ "%02d" | format(d.n) }}</i></div>
      <div>
        <div class="t">{{ d.theme if d.theme is defined and d.theme else (d.spots | join(" · ") if d.spots else "当日行程") }}</div>
        <div class="s">{{ d.date }}{% if d.weekday %} · {{ d.weekday }}{% endif %}{% if d.route and d.route.lane_go %} ｜ {{ d.route.lane_go }}{% endif %}</div>
        <div class="chips">{% for s in d.spots %}<span class="chip"># {{ s }}</span>{% endfor %}</div>
      </div>
    </div>

    {% if d.route %}
    <div class="kpi">
      {% for v, l in d.route.kpi %}<div class="card"><div class="v">{{ v }}</div><div class="l">{{ l }}</div></div>{% endfor %}
    </div>
    <div class="grid3">
      <div class="card"><h4>当日动线</h4><p>{{ d.route.lane_go }}</p></div>
      <div class="card"><h4>交通要点</h4><p>{{ d.route.lane_traffic }}</p></div>
      <div class="card"><h4>当日餐饮主线</h4><p>{{ d.route.lane_food }}</p></div>
    </div>
    {% endif %}

    <div class="subhead mt4"><h3>当日时刻表</h3></div>
    <div class="tl">
      <div class="tl-item" style="--dot:{{ tl_colors[0] }}">
        <div class="card">
          <div class="hd"><span class="slot">上午</span></div>
          <p>{{ d.morning }}</p>
        </div>
      </div>
      <div class="tl-item" style="--dot:{{ tl_colors[1] }}">
        <div class="card">
          <div class="hd"><span class="slot">下午</span></div>
          <p>{{ d.afternoon }}</p>
        </div>
      </div>
      <div class="tl-item" style="--dot:{{ tl_colors[2] }}">
        <div class="card">
          <div class="hd"><span class="slot">晚上</span></div>
          <p>{{ d.evening }}</p>
        </div>
      </div>
    </div>

    {% if d.route %}
    <div class="subhead"><h3>DAY {{ d.n }} 路线 · 全天约 {{ d.route.total_km }} km</h3></div>
    <div class="route-card">
      {% for s in d.route.stops %}
      <div class="route-row">
        <div class="route-badge">{{ s.badge }}</div>
        <div class="route-mid">
          <div class="nm">{{ s.label }}</div>
          {% if s.address %}<div class="ad">{{ s.address }}</div>{% endif %}
          {% if s.note %}<div class="nt">※ {{ s.note }}</div>{% endif %}
        </div>
        <div class="route-right">
          {% if s.nav_url %}
            <a class="nav-btn" href="{{ s.nav_url }}">📱 高德导航 →</a>
          {% elif s.reference_only %}<span class="nav-ref">参考值</span>
          {% endif %}
        </div>
      </div>
      {% if not loop.last %}
      {% set conn = d.route.conns[loop.index0] if loop.index0 < d.route.conns | length else "" %}
      {% if conn %}<div class="route-conn">{{ conn }}</div>{% endif %}
      {% endif %}
      {% endfor %}
      {% if d.route.summary %}<div class="route-tail">※ 点评：{{ d.route.summary }}</div>{% endif %}
      {% for w in d.route.warnings %}<div class="route-tail">※ {{ w }}</div>{% endfor %}
    </div>
    {% endif %}

    {% if d.photos %}
    <div class="subhead"><h3>当日实景</h3></div>
    <div class="dayphotos">
      {% for p in d.photos %}
      <div class="ph">
        {% if p.uri %}<img class="photo" src="{{ p.uri }}" alt="">{% else %}<div class="noimg">图片暂缺</div>{% endif %}
        {% if p.caption %}<div class="cap"><b>{{ p.spot }}</b>　{{ p.caption }}</div>{% else %}<div class="cap">{{ p.spot }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{# ── 柒 预算总盘 ──────────────────────────────── #}
{% if budget %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[6] }}</div><h2>{{ sec_titles[6] }}</h2><span class="sec-en">Money Talks</span></div>
  <div class="sec-sub">全团口径 · 金额为估算参考</div>
  <div class="sec-rule"></div>
  <div class="budget-flex">
    <div style="flex:1; min-width:0">
      <table class="tbl">
        <tr><th>项目</th><th>说明</th><th class="num">金额（元）</th></tr>
        {% for r in budget.rows %}<tr><td>{{ r.item }}</td><td>{{ r.note }}</td><td class="num">{{ r.amount }}</td></tr>{% endfor %}
        <tr class="sum"><td>合计</td><td>{{ budget.note }}</td><td class="num">{{ budget.total }}</td></tr>
      </table>
    </div>
    {% if budget.donut %}
    <div class="donut">
      {{ budget.donut|safe }}
      <div class="legend">
        {% for l in budget.legend %}<div class="li"><span class="sw" style="background:{{ l.color }}"></span>{{ l.label }}　{{ l.amount }}</div>{% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% if budget.stack %}<div class="mt4">{{ budget.stack|safe }}</div>{% endif %}
  <div class="occupancy" style="--occ:{{ budget.occ_color }}"><i style="width:{{ budget.occ_bar }}"></i></div>
  <p class="note">{{ budget.occ_disp }}</p>
  {% for w in budget.warnings %}<p class="note" style="color:var(--red)">※ {{ w }}</p>{% endfor %}
</section>
{% endif %}

{# ── 捌 住宿三选一定稿 ────────────────────────── #}
{% if hotels %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[7] }}</div><h2>{{ sec_titles[7] }}</h2><span class="sec-en">Hotel Anchor</span></div>
  <div class="sec-sub">综合评分序 · 勾选项已按需求筛选 · 支付请在官方渠道完成</div>
  <div class="sec-rule"></div>
  {% if hotel_verdict %}<div class="verdict"><span class="lead">定稿理由：</span>{{ hotel_verdict }}</div>{% endif %}
  <div class="hotels mt8">
    {% for h in hotels %}
    <div class="card {{ 'rec' if loop.first }}">
      <div class="hl-top" style="{{ 'background:var(--red)' if loop.first else ('background:var(--gold)' if loop.index == 2 else 'background:var(--navy)') }}">
        {{ h.tag }}
      </div>
      {% if h.img_uri %}<img class="wide" src="{{ h.img_uri }}" alt="">{% else %}<div class="imgwrap noimg" style="border:none;border-radius:0">图片暂缺</div>{% endif %}
      <div class="hl-body">
        <div class="nm">{{ h.name }}{% if h.selected %}<span class="badge-sel">√ 已勾选</span>{% endif %}</div>
        <div class="pr">{{ h.meta }}</div>
        <p class="muted" style="font-size:8.3pt">{{ h.desc }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── 玖 美食图鉴与注意事项 ────────────────────── #}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[8] }}</div><h2>{{ sec_titles[8] }}</h2><span class="sec-en">Food Map</span></div>
  <div class="sec-sub">必吃清单与避坑提醒</div>
  <div class="sec-rule"></div>

  {% if foods.mode == "notes" %}
  <div class="foodnotes">
    {% for f in foods.notes %}
    <div class="card">
      {% if f.img_uri %}<img src="{{ f.img_uri }}" alt="">{% else %}<div class="noimg" style="width:38mm;flex:none;height:29mm">图片暂缺</div>{% endif %}
      <div><div class="nm">{{ f.name }}</div><p class="mt4">{{ f.intro }}</p></div>
    </div>
    {% endfor %}
  </div>
  {% elif foods.mode == "grid" %}
  <div class="foodgrid">
    {% for f in foods.grid %}<div class="fg">{{ f }}</div>{% endfor %}
  </div>
  {% else %}
  <div class="card"><p>{{ foods.text }}</p></div>
  {% endif %}

  {% if warnings %}
  <div class="warnbox mt8">
    <b>注意事项</b>
    <ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% for s in sources %}
  <p class="srcline">攻略来源[{{ loop.index }}]：{{ s.name }} {{ s.url }}（抓取 {{ s.fetched }}）</p>
  {% endfor %}
  {% if defaults %}
  <p class="srcline" style="color:var(--red)">默认值说明：以下字段由系统按默认值补齐——{{ defaults | join("、") }}</p>
  {% endif %}
</section>

{# ── 拾 美景图鉴 ──────────────────────────────── #}
{% if gallery %}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[9] }}</div><h2>{{ sec_titles[9] }}</h2><span class="sec-en">Scene Book</span></div>
  <div class="sec-sub">景点实拍与简介 · 先睹为快</div>
  <div class="sec-rule"></div>
  <div class="gallery">
    {% for g in gallery %}
    <div class="ph">
      {% if g.uri %}<img class="photo" src="{{ g.uri }}" alt="">{% else %}<div class="noimg">【{{ g.spot }}】图片暂缺</div>{% endif %}
      {% if g.caption %}<div class="cap"><b>{{ g.spot }}</b>　{{ g.caption }}</div>
      {% elif g.source_note %}<div class="cap">{{ g.spot }}　<span class="muted">{{ g.source_note }}</span></div>
      {% else %}<div class="cap">{{ g.spot }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── 拾壹 行前48小时清单 ──────────────────────── #}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[10] }}</div><h2>{{ sec_titles[10] }}</h2><span class="sec-en">Final Check</span></div>
  <div class="sec-sub">预约倒排与装备清单 · 按行程灵活取舍</div>
  <div class="sec-rule"></div>
  <div class="steps">
    {% for t in pretrip %}
    <div class="card"><span class="stepnum">{{ loop.index }}</span><b>第 {{ loop.index }} 步</b>　{{ t }}</div>
    {% endfor %}
  </div>
  <div class="subhead"><h3>装备清单</h3><span class="tag">通用建议</span></div>
  <div class="card">
    <div class="checkgrid">
      {% for t, d in checklist %}<div class="ck"><span class="box"></span><b>{{ t }}</b>　{{ d }}</div>{% endfor %}
    </div>
  </div>
</section>

{# ── 拾贰 应急预案与 Plan B ───────────────────── #}
<section class="sec">
  <div class="sec-head"><div class="sec-num">{{ chapters[11] }}</div><h2>{{ sec_titles[11] }}</h2><span class="sec-en">Stay Ahead</span></div>
  <div class="sec-sub">风险场景与备选方案</div>
  <div class="sec-rule"></div>
  <table class="tbl">
    <tr><th style="width:32%">风险场景</th><th>备选方案</th></tr>
    {% for s, p in emergencies %}<tr><td><b>{{ s }}</b></td><td>{{ p }}</td></tr>{% endfor %}
  </table>
  <p class="footline">本计划由 TripMate 多 Agent 系统生成 · {{ generated_at }} · 车票/酒店请在官方渠道完成支付（系统不接触支付）</p>
</section>

</body>
</html>
