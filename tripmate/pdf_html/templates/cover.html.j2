<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
@page { size: A4; margin: 0; }
html, body { margin: 0; padding: 0; }
{{ css|safe }}
.cover {
  width: 210mm; height: 296.5mm; overflow: hidden; position: relative;
  background: linear-gradient(170deg, #3A2620, #241412); color: #FFF8EE;
  display: flex; flex-direction: column; justify-content: flex-end;
}
.cover-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.cover-shade {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(26, 15, 12, .34) 0%, rgba(26, 15, 12, .12) 34%,
              rgba(26, 15, 12, .30) 58%, rgba(26, 15, 12, .84) 100%);
}
.cover-inner { position: relative; padding: 0 15mm 0; }
.cover-top { position: absolute; top: 13mm; left: 15mm; right: 15mm; display: flex; align-items: center; gap: 5mm; }
.badge {
  background: var(--red); color: #FFF8EE; border-radius: 3pt;
  font-size: 10.5pt; font-weight: 700; letter-spacing: 2.5pt; padding: 2.6pt 11pt;
  font-family: var(--serif); white-space: nowrap;
}
.en-line { font-size: 7.8pt; letter-spacing: 2.4pt; color: rgba(255, 248, 238, .85); text-transform: uppercase; }
.motto-l {
  font-family: var(--serif); color: var(--gold-l); font-size: 12.5pt; letter-spacing: 3pt;
  margin-bottom: 4mm;
}
.title {
  font-family: var(--serif); font-size: 37pt; font-weight: 700; letter-spacing: 2.5pt;
  color: #FFFDF8; line-height: 1.25; margin: 0 0 4mm;
  text-shadow: 2pt 2.4pt 0 rgba(20, 10, 8, .5);
}
.subtitle { font-size: 11pt; color: rgba(255, 248, 238, .92); letter-spacing: 1.5pt; margin-bottom: 7mm; }
.stats { display: flex; gap: 4mm; margin-bottom: 9mm; }
.stats .st {
  flex: 1; background: rgba(30, 17, 14, .55); border: 1px solid rgba(232, 206, 156, .38);
  border-radius: 7pt; padding: 5.5pt 4pt 4.5pt; text-align: center;
}
.stats .num {
  font-family: var(--serif); font-size: 13.5pt; font-weight: 700; color: var(--gold-l);
  white-space: nowrap;
}
.stats .lab { font-size: 7.8pt; color: rgba(255, 248, 238, .78); margin-top: 1pt; white-space: nowrap; }
.countdown {
  margin: 0 -15mm; background: rgba(142, 47, 37, .88); color: #FFF8EE;
  font-size: 9.2pt; font-weight: 700; letter-spacing: .8pt;
  text-align: center; padding: 3.2mm 10mm;
}
.cover-foot {
  position: relative; text-align: center; font-size: 8.2pt; color: rgba(255, 248, 238, .8);
  padding: 3mm 0 3.6mm; letter-spacing: 1pt;
}
</style>
</head>
<body>
<div class="cover">
  {% if cover.cover_uri %}<img class="cover-bg" src="{{ cover.cover_uri }}" alt="">{% endif %}
  <div class="cover-shade"></div>
  <div class="cover-top">
    <span class="badge">{{ cover.badge }}</span>
    <span class="en-line">{{ cover.en_line }}</span>
  </div>
  <div class="cover-inner">
    <div class="motto-l">{{ cover.motto }}</div>
    <h1 class="title">{{ cover.title }}</h1>
    <div class="subtitle">{{ cover.subtitle }}</div>
    <div class="stats">
      {% for num, lab in cover.stats %}
      <div class="st"><div class="num">{{ num }}</div><div class="lab">{{ lab }}</div></div>
      {% endfor %}
    </div>
  </div>
  {% if cover.countdown %}<div class="countdown">{{ cover.countdown }}</div>{% endif %}
  <div class="cover-foot">{{ cover.foot }}</div>
</div>
</body>
</html>
