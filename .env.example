# ===== LLM（必填）=====
# OpenAI 兼容接口。企划书指定硅基流动 + 千问系列；任意兼容服务可无痛替换。
# 硅基流动示例：LLM_BASE_URL=https://api.siliconflow.cn/v1  LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
# 单次 LLM 调用超时（秒）与重试次数：预算越宽，限流时一次调用挂得越久。
# 默认 150s × 2 次尝试（最坏 ~5 分钟）；失败会尽快进入护栏/降级链路。
LLM_TIMEOUT_S=150
LLM_MAX_RETRIES=1

# ===== 搜索引擎（可选，未配置走降级模拟攻略）=====
# https://tavily.com 每月 1000 次免费
TAVILY_API_KEY=

# ===== 高德官方 MCP（可选，未配置距离走确定性参考值）=====
# 需「Web 服务」类型 Key：https://lbs.amap.com/api/mcp-server/create-project-and-key
AMAP_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/sse

# ===== 社区 12306-MCP（默认 npx 拉起，需 Node >= 18；失败自动降级模拟班次表）=====
MCP_12306_COMMAND=npx -y 12306-mcp

# ===== 社区酒店 MCP（覆盖不全，默认不配置 → 走模拟酒店库）=====
MCP_HOTEL_URL=

# ===== 天气（默认 Open-Meteo 免 Key 真实数据源，无需配置）=====
# WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# ===== 成本与行为 =====
TOKEN_BUDGET=200000
ALLOW_MOCK_FALLBACK=1

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
